# All optional. The backend runs fully without any of these — the executor and
# LLM fallback degrade to labelled mocks rather than failing.

# Razorpay TEST-MODE keys (dashboard → Settings → API Keys, test mode).
# With these set, the executor makes real test-mode calls: payment links for
# outreach, orders for retry scheduling. Never use live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cap on real Razorpay calls per batch (proves the integration; avoids 500 calls/run).
EXECUTOR_MAX_LIVE_CALLS=8

# Anthropic key for the diagnosis layer's LLM fallback on ambiguous reason codes.
ANTHROPIC_API_KEY=

# Sarvam key for real Hinglish speech in the voice call room (bulbul:v3 TTS,
# saaras:v3 STT). Free tier at sarvam.ai covers the demo many times over.
# Without it the call script is produced and every turn says no audio was made.
SARVAM_API_KEY=

# Shared secret for POST /webhooks/razorpay, from the Razorpay dashboard's
# webhook settings. Without it the endpoint refuses every delivery — it will
# never act on an unsigned payload.
RAZORPAY_WEBHOOK_SECRET=
